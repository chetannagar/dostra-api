# Production Dockerfile for the Laravel API.
#
# Key differences from the dev image:
# - uses PHP-FPM (not php artisan serve) — Nginx proxies requests to it
# - installs Composer dependencies without dev packages
# - optimizes the autoloader for faster class resolution
# - caches routes, views, and events at build time (no env vars needed)
# - does NOT cache config at build time — env vars are not available then
# - runs as www-data (non-root) for security
# - source is copied into the image — no bind mounts in production
# - config cache + migrations run at container startup via CMD

FROM php:8.4-fpm

# Application path inside the container.
WORKDIR /var/www/html

# Install system packages and PHP extensions required by this Laravel + Filament app.
# - git/unzip: needed by Composer
# - libicu-dev: required for intl
# - libonig-dev: required for mbstring
# - libpq-dev: required for pdo_pgsql
# - libxml2-dev: required for dom/xml
# - libzip-dev: required for zip
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git \
        unzip \
        libicu-dev \
        libonig-dev \
        libpq-dev \
        libxml2-dev \
        libzip-dev \
    && docker-php-ext-install \
        bcmath \
        dom \
        exif \
        intl \
        mbstring \
        pcntl \
        pdo \
        pdo_pgsql \
        xml \
        zip \
    && rm -rf /var/lib/apt/lists/*

# Copy Composer from the official image.
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Copy only dependency manifests first so Docker can cache the vendor layer.
# This layer is invalidated only when composer.json or composer.lock changes,
# not on every app code change.
COPY composer.json composer.lock ./

# Install production dependencies only.
RUN composer install \
    --no-dev \
    --optimize-autoloader \
    --no-interaction \
    --no-progress \
    --prefer-dist

# Copy the rest of the application source.
COPY . .

# Prepare Laravel writable directories and set ownership so PHP-FPM (www-data)
# can write to storage and bootstrap/cache.
RUN mkdir -p \
        storage/framework/cache \
        storage/framework/sessions \
        storage/framework/views \
        storage/logs \
        bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache \
    && chmod -R ug+rwx storage bootstrap/cache

# Cache routes, views, and events at build time.
# These do not require env vars so they are safe to run during the build.
# Config cache is intentionally excluded — it needs real env vars (APP_KEY,
# DB_HOST, etc.) which are only available at runtime.
RUN php artisan route:cache \
    && php artisan view:cache \
    && php artisan event:cache

# PHP-FPM listens on port 9000. Nginx will proxy requests to this port.
EXPOSE 9000

# At container startup:
# 1. Cache config using the real runtime env vars injected by Docker/orchestrator.
# 2. Run any pending migrations (--force bypasses the production prompt).
# 3. Start PHP-FPM in the foreground.
CMD ["sh", "-c", "php artisan config:cache && php artisan migrate --force && php-fpm"]
