# Production Dockerfile for the Laravel API.
#
# Key differences from the dev image:
# - uses PHP-FPM (not php artisan serve) — Nginx proxies requests to it
# - installs Composer dependencies without dev packages
# - optimizes the autoloader for faster class resolution
# - caches config, routes, events, and views at container startup
#   (php artisan optimize), when the real env vars are available
# - runs entirely as www-data (non-root): startup commands and PHP-FPM
# - source is copied into the image — no bind mounts in production
# - startup logic lives in docker/entrypoint.prod.sh
# - migrations run at startup by default; set RUN_MIGRATIONS=false to disable

# Pin PHP to an exact patched release instead of a floating tag, which could
# silently reuse an old cached image.
# Must satisfy "php" in composer.json (~8.4.27 || ^8.5.12).
# To upgrade PHP later, bump this value and rebuild.
ARG PHP_VERSION=8.5.12
FROM php:${PHP_VERSION}-fpm-alpine

# Application path inside the container.
WORKDIR /var/www/html

# Install system packages and the PHP extensions this Laravel + Filament app
# needs that are NOT already in the official image.
# - git/unzip: needed by Composer
# - icu-dev: required for intl
# - postgresql-dev: required for pdo_pgsql
# - libzip-dev: required for zip
#
# Already built into the official php image, so NOT listed here:
# dom, xml, mbstring, pdo, opcache. Recompiling them fails on PHP 8.5
# (dom now depends on the bundled Lexbor parser), and OPcache is a built-in,
# always-on part of PHP since 8.5.
RUN apk add --no-cache \
        git \
        unzip \
        icu-dev \
        postgresql-dev \
        libzip-dev \
    && docker-php-ext-install \
        bcmath \
        exif \
        intl \
        pcntl \
        pdo_pgsql \
        zip

# Copy Composer from the official image.
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Copy only dependency manifests first so Docker can cache the vendor layer.
# This layer is invalidated only when composer.json or composer.lock changes,
# not on every app code change.
COPY composer.json composer.lock ./

# Install production dependencies only, without scripts or autoloader.
# - --no-scripts: composer.json scripts call "php artisan ...", but artisan
#   and the app source don't exist in the image yet at this point.
# - --no-autoloader: the autoloader is generated after the source is copied
#   (see below), because it needs to see the app/ classes.
# This step still checks the container's PHP version against composer.json,
# so an unpatched base image fails the build here.
RUN composer install \
    --no-dev \
    --no-scripts \
    --no-autoloader \
    --no-interaction \
    --no-progress \
    --prefer-dist

# Copy the rest of the application source.
COPY . .

# Now that the full source is present, generate the optimized autoloader.
# This also:
# - runs the post-autoload-dump scripts (package:discover, filament:upgrade)
# - regenerates vendor/composer/platform_check.php, which blocks
#   unsupported PHP versions at runtime
RUN composer dump-autoload \
    --optimize \
    --no-dev \
    --no-interaction

# Prepare Laravel writable directories and give them to www-data, the user
# the container runs as. Done after all build steps that write files, so
# nothing in these directories ends up owned by root.
RUN mkdir -p \
        storage/framework/cache \
        storage/framework/sessions \
        storage/framework/views \
        storage/logs \
        bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache \
    && chmod -R ug+rwx storage bootstrap/cache \
    && chmod +x docker/entrypoint.prod.sh

# Run everything from here on as www-data (non-root): the startup script,
# artisan commands, and the PHP-FPM master process.
USER www-data

# PHP-FPM listens on port 9000. Nginx will proxy requests to this port.
EXPOSE 9000

# Startup: cache, migrate (optional), then hand over to PHP-FPM.
# See docker/entrypoint.prod.sh.
CMD ["/var/www/html/docker/entrypoint.prod.sh"]
